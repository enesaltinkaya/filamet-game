// Azgaar props (vegetation) material (Shader10).
//
// Renders the streaming scattered props of the Azgaar world (phase 7 of
// plans/azgaar-terrain.md): a merged species mesh (unit height, base at
// y=0) drawn once per (tile, species, variant) range as an InstancedDraw.
// Filament has no arbitrary per-instance attributes, so each instance's
// data (pos, yaw, scale, tint, wind phase) lives in the per-tile
// instanceData texture (3 RGBA32F texels per instance, fetched here from
// the vertex stage via getInstanceIndex()); the range's mesh sub-range,
// wind-sway weight and look flags come from the range's material-instance
// uniforms.
//
// instanceData layout (3 RGBA32F texels per instance, NEAREST, 1024 wide):
//   texel 3i   = pos.xyz, yaw
//   texel 3i+1 = scale, tint.rgb
//   texel 3i+2 = phase, ---
// meshA = (boundsMin.xyz, swayFactor); meshB = (boundsMax.xyz, flags)
// flags: bit0 = alpha-test the base texture (cutout grass cards),
//        bit2 = radial flower-disc test on the unit-UV quad.
//
// Look (port of the old engine's azgaar_props.vert/.frag):
//   - the vertex stage does the whole instance transform (yaw rotation +
//     uniform scale + ground placement; the object transform stays
//     identity)
//   - wind sway: world-space drift weighted by the mesh-height fraction
//     squared (base anchored) x the species' sway factor, de-synced by the
//     per-instance phase
//   - per-instance tint (biome colour x patch noise x jitter) applied to
//     the white (tintable) parts of the mesh; baked part colours (trunks,
//     rocks) keep their own colour
//   - grass cards: alpha-tested crossed cards over the per-variant card
//     texture; flowers: radial disc test on the unit-UV quad
// Shading: the built-in lit PBR model (the engine's renderer owns the
// lights). The VBO's TANGENTS attribute carries each vertex's normal as a
// unit frame quaternion (the object transform is identity, so the decoded
// world normal IS the mesh normal); the vertex stage re-rotates it with
// the instance yaw so the lighting follows the tree. doubleSided lights
// both faces of the blades/sides (the pipeline flips the normal on back
// faces), which is what thin blades need.

material {
    name : AzgaarProps,
    shadingModel : lit,
    doubleSided : true,
    instanced : true,
    blending : opaque,
    // The grass card mesh UVs are authored in raw image-row order: V=0 is the
    // image top (tuft tips, stb row 0, uploaded unflipped via setImage) and
    // V=bottomV trims the texture's empty bottom band at the card's base.
    // Filament's built-in vertex stage flips uv0.y by default (flipUV, see
    // MaterialBuilder), which would mirror the card vertically — tuft tips at
    // the ground, base at the top (the upside-down-grass bug). Disable it so
    // getUV0() returns the mesh UVs as authored. The flower radial test
    // (length(getUV0()-0.5)) is flip-invariant, and instanceData is fetched
    // with explicit UVs, so nothing else in this material is affected.
    flipUV : false,
    requires : [
        tangents,
        uv0,
        custom0
    ],
    variables : [
        {
            name : "partColor",
            precision : "high"
        }
    ],
    parameters : [
        {
            type : sampler2d,
            name : instanceData
        },
        {
            type : sampler2d,
            name : cardTex
        },
        {
            type : float4,
            name : meshA
        },
        {
            type : float4,
            name : meshB
        },
        {
            type : float4,
            name : instOff
        },
        {
            type : float4,
            name : instUV  // (1/texW, 1/texH) — normalizes the instance-texel UVs
        },
        {
            type : float4,
            name : wind
        },
        {
            // Tile origin relative to the world anchor (this frame): the
            // instance data is tile-local and the vertex stage places it
            // in the anchor-space "world" frame with this offset (the
            // renderable transform carries the same value for culling).
            type : float4,
            name : tileRel
        }
    ]
}

vertex {
    // Row-major over the fixed 1024-wide instance texture (must match the
    // pass' kInstanceTexWidth). The texel-center coordinates are normalized
    // with instUV = (1/width, 1/height): sampler UVs are [0,1], so the raw
    // texel coordinates would clamp every fetch to the texture edge and
    // collapse all instances onto one instance's data.
    vec2 instanceUV(int texel) {
        return vec2((mod(float(texel), 1024.0) + 0.5) * materialParams.instUV.x,
                    (float(int(float(texel) / 1024.0)) + 0.5) * materialParams.instUV.y);
    }

    void materialVertex(inout MaterialVertexInputs material) {
        int idx  = getInstanceIndex() + int(materialParams.instOff.x + 0.5);
        int base = idx * 3;
        vec4 ia   = texture(materialParams_instanceData, instanceUV(base + 0));
        vec4 ib   = texture(materialParams_instanceData, instanceUV(base + 1));
        vec4 ic   = texture(materialParams_instanceData, instanceUV(base + 2));

        // Uniform scale (mesh is unit height: scale == target metres),
        // then yaw rotation around Y.
        vec3 local = getPosition().xyz * ib.x;
        float cy   = cos(ia.w);
        float sy   = sin(ia.w);
        mat3 rot   = mat3(cy, 0.0, -sy,
                          0.0, 1.0, 0.0,
                          sy, 0.0,  cy);

        // Wind sway: weight by the fraction of the mesh height squared
        // (base stays anchored) x the species' sway factor; the
        // per-instance phase de-syncs the field. World-space drift
        // (independent of the instance yaw).
        float span  = max(materialParams.meshB.y - materialParams.meshA.y, 1e-3);
        float hN    = clamp((getPosition().y - materialParams.meshA.y) / span, 0.0, 1.0);
        float swayW = hN * hN * materialParams.meshA.w;
        float sway  = sin(materialParams.wind.z + ic.x) * materialParams.wind.w * swayW;

        // Anchor-space "world" placement: instance tile-local ground position
        // + rotated, scaled mesh local offset + world-space wind drift + the
        // tile's anchor-relative origin. material.worldPosition is the final
        // vertex position (clip = clipFromWorld * worldPosition — the
        // renderable transform is NOT applied to it, it only moves the
        // culling box), so the tile offset must be added here explicitly.
        vec3 worldPos = ia.xyz + rot * local + materialParams.tileRel.xyz;
        // World-space wind drift along the CONSTANT wind direction
        // (dirX, dirZ) = wind.xy, scaled by the bounded oscillating sway.
        // (wind.z is the accumulated phase — it is the sway's time argument,
        // not a direction; using it here made the drift grow without bound.)
        worldPos.xz  += vec2(materialParams.wind.x, materialParams.wind.y) * sway;
        material.worldPosition.xyz = worldPos;

        // The TANGENTS attribute decoded by the built-in stage carries the
        // mesh's per-vertex normal (unit frame, identity object transform) —
        // rotate it with the instance yaw so the lighting follows the tree.
        material.worldNormal = rot * normalize(material.worldNormal);

        // Per-part tint mask: a white vertex colour marks a part as
        // tintable (leaves / canopy) and receives the per-instance biome
        // tint; a baked non-white colour (trunk, rock) keeps it. The mask
        // rides the CUSTOM0 attribute — read it explicitly (a declared
        // variable like partColor is just a varying: without this read it
        // stays vec4(0) and every part goes black). The mix result passes
        // to the fragment as `partColor`.
        material.partColor = getCustom0();
        vec3 part      = material.partColor.xyz;
        float tintable = step(0.99, min(part.r, min(part.g, part.b)));
        material.partColor.xyz = mix(part, part * ib.yzw, tintable);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        int flags = int(materialParams.meshB.w + 0.5);
        vec3 albedo = variable_partColor.xyz;

        // bit 0: alpha-test the base texture (cutout grass cards).
        if (mod(float(flags), 2.0) > 0.5) {
            vec4 t = texture(materialParams_cardTex, getUV0());
            if (t.a < 0.5) discard;
            albedo *= t.rgb;
        }
        // bit 2: radial alpha test — keep only a small central disc of the
        // unit-UV flower quad so it reads as a sparse flower dot.
        if (mod(floor(float(flags) / 4.0), 2.0) > 0.5) {
            if (length(getUV0() - 0.5) > 0.30) discard;
        }

        material.baseColor = vec4(albedo, 1.0);
        material.roughness = 0.9;
        material.metallic  = 0.0;
    }
}
