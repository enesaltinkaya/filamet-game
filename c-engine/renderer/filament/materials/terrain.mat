// Heightmap terrain material (Shader10).
//
// Renders the streaming HeightmapTerrain lattice (precomputed per-tile
// world-space corners: position + tangent frame, see
// ecs/system/heightmap/HeightmapLattice.h). The vertex stage is empty:
// the built-in VS transforms the corner attributes; every look decision
// lives in the fragment stage below.
//
// Shading model: Filament's built-in `lit` PBR (directional sun +
// ambient/IBL) — the engine's renderer owns the lights. The fragment only
// produces the material properties (albedo / roughness / normal).
//
// The look is a port of the old engine's heightmap_terrain.frag:
//   - default grass texture, world-space tiling + tangent normal map
//   - per-world biome tint (biomeColor texture, registered at world load)
//   - dry-turf colour variation (coarse world-anchored value noise)
//   - waterline: beach sand band + wet-sand strip at sea level
//   - slope-based triplanar cliff + altitude rock band
//   - climate snow line (temperature + Glacier biome, climate texture)
//   - micro-band normal perturbation (32/16/8/4 m value noise) with
//     derivative-based octave fade and grazing gain
// The geometry band (wavelengths >= 64 m) is baked into the lattice
// heights; only 32/16/8/4 m perturb the shading normal here, so the
// rendered surface stays exactly the CPU/physics bilinear surface.

material {
    name : HeightmapTerrain,
    shadingModel : lit,
    parameters : [
        // Default terrain textures (engine pak, KTX2/BC7).
        {
            type : sampler2d,
            name : grassAlbedo
        },
        {
            type : sampler2d,
            name : grassNormal
        },
        {
            type : sampler2d,
            name : cliffAlbedo
        },
        {
            type : sampler2d,
            name : cliffNormal
        },
        {
            type : sampler2d,
            name : snowAlbedo
        },
        {
            type : sampler2d,
            name : sandAlbedo
        },
        // Per-world look textures (registered at world load; sampled
        // through the map-space UV derived from mapBounds).
        {
            type : sampler2d,
            name : biomeColor
        },
        {
            type : sampler2d,
            name : climate
        },
        // Same texture as `climate`, NEAREST-sampled: its A channel carries
        // discrete biome ids, which bilinear filtering would invent bogus
        // intermediate biomes from.
        {
            type : sampler2d,
            name : climateNearest
        },
        // Map bounds in world metres (map centred at the world origin):
        // x = minX, y = minZ, z = maxX, w = maxZ.
        {
            type : float4,
            name : mapBounds
        },
        // x = snowLo (deg C), y = snowHi (deg C), z = beachHeight (m),
        // w = climate blending enabled (0/1).
        {
            type : float4,
            name : climateParams
        },
        // Peak land elevation in metres (drives the altitude rock band).
        {
            type : float,
            name : maxLandHeight
        },
        // Debug view: 0 = off, 1 = periodic height ramp (one hue cycle per
        // 256 m, grid validation), 2 = raw biome-colour texture sample
        // (UV / texture registration validation).
        {
            type : float,
            name : debugView
        }
    ],
}

fragment {
    // World-space tiling frequency for the grass texture (repeats per
    // metre); same ratio as the old engine's azgaar heightmap pass.
    #define AZGAAR_GRASS_TILE (2048.0 / 7000.0)
    #define AZGAAR_CLIFF_DETAIL_TILE 32.0
    #define CLIFF_TRIPLANAR_SCALE (AZGAAR_CLIFF_DETAIL_TILE / 4096.0)
    #define SPLAT_NORMAL_STRENGTH 2.0

    // Flat fallback albedos when a texture is unavailable.
    #define AZGAAR_FALLBACK_GRASS_COLOR vec3(0.36, 0.55, 0.28)
    #define AZGAAR_FALLBACK_SNOW_COLOR vec3(0.90, 0.92, 0.96)
    #define AZGAAR_FALLBACK_SAND_COLOR vec3(0.76, 0.70, 0.55)

    // Climate texture R channel encoding (azgaarWorldPackClimateTexture):
    // byte = temperature (deg C) + bias. The bias keeps the encode
    // monotonic so bilinear filtering cannot ring across a sign change.
    #define AZGAAR_CLIMATE_TEMP_BIAS 64.0
    // Biome id (FMG): 11 = Glacier.
    #define AZGAAR_BIOME_GLACIER 11.0

    #define MICRO_NOISE_STRENGTH 0.45

    // fract-based cell hash (the old engine's utils.shader hash, kept so
    // the procedural noise fields read identically on both backends).
    float hash21(vec2 p) {
        p = fract(p * 0.3183099 + vec2(0.1, 0.3));
        p *= 17.0;
        return fract(p.x * p.y * (p.x + p.y));
    }

    float microValueNoise(vec2 p) {
        vec2 ip = floor(p);
        vec2 fp = p - ip;
        vec2 u  = fp * fp * (3.0 - 2.0 * fp);
        float a = hash21(ip);
        float b = hash21(ip + vec2(1.0, 0.0));
        float c = hash21(ip + vec2(0.0, 1.0));
        float d = hash21(ip + vec2(1.0, 1.0));
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 2.0 - 1.0;
    }

    // Grazing-aware octave fade: an octave of wavelength `lambda` is only
    // kept while it spans a few pixels in BOTH screen directions, keyed on
    // the screen-space derivatives of the world-XZ noise input (the true
    // on-screen sampling rate, including grazing-angle depth compression).
    float octaveFade(float lambda, float dpx, float dpy) {
        float pxX = lambda / max(dpx, 1e-5);
        float pxY = lambda / max(dpy, 1e-5);
        return smoothstep(2.0, 8.0, min(pxX, pxY));
    }

    // Synthetic "height" of the micro band (metres), used only for its
    // slope. Each octave is derivative-faded so sub-pixel octaves do not
    // alias into specular smudges at grazing angles.
    float microBumpFaded(vec2 p, float dpx, float dpy) {
        return 0.5 * microValueNoise(p / 32.0 + 11.17) * octaveFade(32.0, dpx, dpy) +
               0.25 * microValueNoise(p / 16.0 + 5.93) * octaveFade(16.0, dpx, dpy) +
               0.5 * microValueNoise(p / 8.0 + 7.31) * octaveFade(8.0, dpx, dpy) +
               0.25 * microValueNoise(p / 4.0 + 3.7) * octaveFade(4.0, dpx, dpy);
    }

    vec3 safeNormalize(vec3 v, vec3 fallback) {
        float len2 = dot(v, v);
        if (len2 <= 1e-8) return fallback;
        return v / sqrt(len2);
    }

    vec3 triplanarWeights(vec3 worldNormal, float sharpness) {
        vec3 w = abs(worldNormal);
        w      = pow(w, vec3(sharpness));
        return w / (w.x + w.y + w.z + 1e-6);
    }

    // Tangent frame built from a world normal (same construction the CPU
    // lattice packs into the per-vertex tangent quaternion, so normal maps
    // land on the same frame on both backends).
    mat3 buildTerrainTBN(vec3 geomNormal) {
        vec3 N = safeNormalize(geomNormal, vec3(0.0, 1.0, 0.0));
        vec3 T = vec3(1.0, 0.0, 0.0) - N * N.x;
        T      = safeNormalize(T, vec3(1.0, 0.0, 0.0));
        vec3 B = vec3(0.0, 0.0, 1.0) - N * N.z - T * dot(T, vec3(0.0, 0.0, 1.0));
        B      = safeNormalize(B, safeNormalize(cross(T, N), vec3(0.0, 0.0, 1.0)));
        return mat3(T, B, N);
    }

    void material(inout MaterialInputs material) {
        // getUserWorldPosition(), NOT getWorldPosition(): this Filament build
        // renders with the view origin shifted to the camera (Engine.debug.
        // view.camera_at_origin defaults true), so getWorldPosition() is
        // CAMERA-RELATIVE and every world-anchored field below (world-space
        // tiling, dry-turf noise, sea-level/beach/snow/rock bands, mapBounds
        // UV) would swim with the camera — the ground reads as a treadmill
        // that never stays put under flight. getUserWorldPosition() is the
        // API-level (absolute) world position; directions (V, normals) stay
        // on the shifted frame, which is fine (translation-invariant).
        vec3 worldPos = getUserWorldPosition();
        vec3 V        = getWorldViewVector();
        vec3 geomNormal = normalize(getWorldGeometricNormalVector());

        // World-space tiled UV for the grass texture (stable across tiles).
        vec2 grassUV = worldPos.xz * AZGAAR_GRASS_TILE;

        vec3 baseColor;
        float roughness = 0.9;
        vec3 N          = geomNormal;

        // Default grass albedo (rgb) + roughness (a).
        vec4 a = texture(materialParams_grassAlbedo, grassUV);
        baseColor = a.rgb;
        roughness = clamp(a.a, 0.04, 1.0);

        // Tangent-space normal mapping (frame from the per-vertex tangent
        // quaternion; the terrain lattice has no UVs).
        {
            vec4 n = texture(materialParams_grassNormal, grassUV);
            vec2 nxy = (n.rg * 2.0 - 1.0) * SPLAT_NORMAL_STRENGTH;
            float nz = sqrt(max(1.0 - dot(nxy, nxy), 0.0));
            mat3 TBN = buildTerrainTBN(geomNormal);
            N        = safeNormalize(TBN * vec3(nxy, nz), geomNormal);
        }

        // ── Azgaar climate fields ────────────────────────────────────────
        // Static per-world textures sampled through the map-space UV
        // derived from the terrain bounds the game sets at world load.
        // Map +X is world -X and map +Y is world -Z (azgaarMapToWorld),
        // hence the mirrored formulation.
        vec2 mapExtent  = materialParams.mapBounds.zw - materialParams.mapBounds.xy;
        bool climateOn  = materialParams.climateParams.w > 0.5 && mapExtent.x > 1.0 &&
                          mapExtent.y > 1.0;
        vec4 climate    = vec4(0.0);
        float landMask  = smoothstep(0.0, 0.2, worldPos.y);  // sea level = 0 m
        float snowT     = 0.0;
        float beachT    = 0.0;

        // Map-space UV is always available (the bounds are valid even when
        // the per-world climate fields are off) — the debug views use it too.
        vec2 mapUV = vec2(0.0);
        bool mapUVValid = mapExtent.x > 1.0 && mapExtent.y > 1.0;
        if (mapUVValid) {
            mapUV = clamp(
                vec2((materialParams.mapBounds.z - worldPos.x) / mapExtent.x,
                     (materialParams.mapBounds.w - worldPos.z) / mapExtent.y),
                0.0, 1.0);
        }

        if (climateOn) {
            // 1) Biome tint over the grass base — soft multiply keeps the
            // grass texture detail while the world reads as FMG's authored
            // biome map.
            vec3 biomeT = texture(materialParams_biomeColor, mapUV).rgb;
            baseColor   = mix(baseColor, baseColor * (biomeT * 2.0), 0.55);

            climate = texture(materialParams_climate, mapUV);
        }

        // ── Turf colour variation (dry-grass patches) ────────────────────
        // Coarse world-anchored value noise (12 m / 48 m) splits the ground
        // into patches of dry, sun-bleached straw and surviving green turf.
        // Inserted before the beach/cliff/snow swaps so only the grass
        // base is affected.
        {
            float n = 0.6 * microValueNoise(worldPos.xz / 12.0 + 31.7) +
                      0.4 * microValueNoise(worldPos.xz / 48.0 + 71.3);  // [-1,1]
            float dryMask = smoothstep(0.32, 0.62, 0.5 + 0.5 * n);
            vec3 dryColor = vec3(0.58, 0.50, 0.32);
            float wobble  = 0.82 + 0.36 * (0.5 + 0.5 * microValueNoise(worldPos.xz / 4.0 + 13.9));
            baseColor    = mix(baseColor, dryColor, dryMask) * wobble;
        }

        // 2) Beach band: low land near sea level becomes sand, with a
        // darker wet-sand strip right at the waterline.  Driven by the
        // fragment's own height (metres), not the coarse climate grid.
        {
            float beachH = materialParams.climateParams.z;
            if (beachH > 0.0) {
                // The sand band extends ~1.5 m below the waterline: the
                // shallow submerged shelf would otherwise keep the grass
                // tint and read as a green ring seen through the water.
                float beachMask = smoothstep(-1.5, 0.2, worldPos.y);
                beachT = (1.0 - smoothstep(beachH * 0.24, beachH, worldPos.y)) * beachMask;
                float wetT = (1.0 - smoothstep(0.1, 1.2, worldPos.y)) * landMask;
                vec3 sandColor = texture(materialParams_sandAlbedo, grassUV).rgb;
                baseColor = mix(baseColor, sandColor, beachT);
                baseColor = mix(baseColor, sandColor * 0.55, wetT);
            }
        }

        // Slope-based cliff texturing + altitude rock band.  The rock
        // weight is the max of the slope blend and a highland band (55%..
        // 85% of the world's max land height), so exposed rock appears both
        // on steep faces and on high plateaus above the tree line.
        float rockT = 0.0;
        {
            float slope      = 1.0 - max(dot(geomNormal, vec3(0.0, 1.0, 0.0)), 0.0);
            float cliffBlend = smoothstep(0.1, 0.4, slope);
            float rockAlt    = materialParams.maxLandHeight > 1.0
                                   ? smoothstep(0.55, 0.85, worldPos.y / materialParams.maxLandHeight) * landMask
                                   : 0.0;
            rockT            = max(cliffBlend, rockAlt);

            if (rockT > 0.01) {
                // Triplanar sampling for the cliff texture.
                vec3 w   = triplanarWeights(geomNormal, 4.0);
                vec2 uvX = worldPos.zy * CLIFF_TRIPLANAR_SCALE;
                vec2 uvY = worldPos.xz * CLIFF_TRIPLANAR_SCALE;
                vec2 uvZ = worldPos.xy * CLIFF_TRIPLANAR_SCALE;

                vec4 cliffAlbedoSample = texture(materialParams_cliffAlbedo, uvX) * w.x +
                                         texture(materialParams_cliffAlbedo, uvY) * w.y +
                                         texture(materialParams_cliffAlbedo, uvZ) * w.z;

                vec3 cliffBase             = cliffAlbedoSample.rgb;
                float cliffRoughnessSample = clamp(cliffAlbedoSample.a, 0.04, 1.0);

                baseColor = mix(baseColor, cliffBase, rockT);
                roughness = mix(roughness, cliffRoughnessSample, rockT);

                vec4 cliffNormalSample = texture(materialParams_cliffNormal, uvX) * w.x +
                                         texture(materialParams_cliffNormal, uvY) * w.y +
                                         texture(materialParams_cliffNormal, uvZ) * w.z;

                vec2 nxy = cliffNormalSample.rg * 2.0 - 1.0;
                nxy *= SPLAT_NORMAL_STRENGTH;
                float nz                = sqrt(max(1.0 - dot(nxy, nxy), 0.0));
                vec3 cliffTangentNormal = normalize(vec3(nxy, nz));

                mat3 TBN              = buildTerrainTBN(geomNormal);
                vec3 cliffWorldNormal = normalize(TBN * cliffTangentNormal);

                N = normalize(mix(N, cliffWorldNormal, rockT));
            }
        }

        // 3) Snow line — last so the peaks stay white over rock.  FMG's
        // cell temperature already falls with altitude, so the isotherm
        // band gives a natural altitude snow line; the Glacier biome is
        // snow unconditionally.  A value-noise breakup keeps the line from
        // reading as a contour.
        if (climateOn) {
            // The A channel carries discrete biome ids (nearest-cell
            // values), so it must be read through a NEAREST sampler.
            vec4 climateNearest = texture(materialParams_climateNearest, mapUV);
            float tempC   = climate.r * 255.0 - AZGAAR_CLIMATE_TEMP_BIAS;
            float biomeId = floor(climateNearest.a * 255.0 + 0.5);
            float snowLo  = materialParams.climateParams.x;
            float snowHi  = materialParams.climateParams.y;

            snowT = 1.0 - smoothstep(snowLo, snowHi, tempC);
            snowT = max(snowT,
                        (biomeId > AZGAAR_BIOME_GLACIER - 0.5 &&
                         biomeId < AZGAAR_BIOME_GLACIER + 0.5) ? 1.0 : 0.0);
            snowT *= landMask;
            snowT *= 0.75 + 0.25 * (0.5 + 0.5 * microValueNoise(worldPos.xz * 0.02));

            if (snowT > 0.004) {
                vec3 snowColor = texture(materialParams_snowAlbedo, grassUV).rgb;
                baseColor = mix(baseColor, snowColor, snowT);
                // Snow normal stays flat (the micro-band noise below still
                // applies, which reads well on snow).
                N = normalize(mix(N, geomNormal, snowT));
            }
        }

        // Roughness follows the same material chain (snow smooth, sand
        // rough).
        roughness = mix(roughness, 0.6, snowT);
        roughness = mix(roughness, 0.85, beachT);

        // Micro-band roughness: perturb the shading normal with the 4-32 m
        // value noise (finite differences, 0.5 m step).  Does not move
        // geometry.  Two guards keep the GGX lobe from smudging:
        //   1) octaveFade (screen-space derivatives) fades sub-pixel
        //      octaves out;
        //   2) grazing gain: the tilt is only useful where the detail
        //      reads (steep view), so it attenuates to zero as the view
        //      goes grazing (keyed on the stable pre-perturbation normal).
        {
            const float e = 0.5;
            vec2 p        = worldPos.xz;
            float dpx = length(dFdx(p));
            float dpy = length(dFdy(p));
            float hC  = microBumpFaded(p, dpx, dpy);
            float hX  = microBumpFaded(p + vec2(e, 0.0), dpx, dpy);
            float hZ  = microBumpFaded(p + vec2(0.0, e), dpx, dpy);
            vec3 microN    = vec3((hC - hX) / e, 0.0, (hC - hZ) / e);

            float geomNdotV   = max(dot(geomNormal, V), 0.0);
            float grazingGain = smoothstep(0.05, 0.30, geomNdotV);
            N                 = safeNormalize(N + microN * (MICRO_NOISE_STRENGTH * grazingGain), N);
        }

        // ── Debug views (see the debugView parameter doc) ────────────────
        //   1 = height ramp — periodic hue cycle, one full cycle per 256 m
        //       (validates the lattice heights against the CPU grid).
        //   2 = raw biome-colour texture (validates mapBounds UV mapping +
        //       per-world texture registration).
        // Drawn as a flat matte surface (no normal maps, roughness 1) rather
        // than emissive: Filament's emissive is photometric (nits, scaled by
        // the camera exposure exactly like the lights), so a 0..1 debug value
        // is invisible next to a ~1e5-nit sun and would need the game's light
        // intensities to be reproduced here. A 100% diffuse surface keeps the
        // colours readable for any lighting and still shows the geometry.
        bool dbgOn    = materialParams.debugView > 0.5;
        vec3 dbgColor = vec3(1.0);
        if (dbgOn) {
            if (materialParams.debugView < 1.5) {
                float h = worldPos.y;
                dbgColor = 0.5 + 0.5 * cos(6.2831853 * (h * (1.0 / 256.0) + vec3(0.0, 0.33, 0.67)));
            } else if (mapUVValid) {
                dbgColor = texture(materialParams_biomeColor, mapUV).rgb;
            }
        }

        // `material.normal` is in the per-vertex tangent frame (prepareMaterial
        // multiplies it by the tangent frame to get the shading normal); the
        // look above was built in world space, so convert. prepareMaterial()
        // consumes material.normal, so it must be the last thing written
        // before the call.
        material.normal = dbgOn ? vec3(0.0, 0.0, 1.0)
                                : normalize(transpose(getWorldTangentFrame()) * N);

        prepareMaterial(material);
        material.baseColor = vec4(dbgOn ? dbgColor : baseColor, 1.0);
        material.roughness = dbgOn ? 1.0 : roughness;
    }
}
