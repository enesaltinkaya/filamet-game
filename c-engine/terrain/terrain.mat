material {
    name : "TerrainSplat",
    parameters : [
        {
            type : sampler2dArray,
            name : splatTiles
        },
        {
            type : sampler2dArray,
            name : styleAlbedo
        },
        {
            type : sampler2dArray,
            name : styleNormal
        },
        {
            type : int[100],
            name : tileLayer0
        },
        {
            type : int[100],
            name : tileLayer1
        },
        {
            type : int[100],
            name : tileLayer2
        },
        {
            type : int[12],
            name : styleRemap
        },
        {
            type : int,
            name : defaultStyle
        },
        {
            type : float,
            name : styleTiling
        }
    ],
    requires : [
        uv0,
        tangents
    ],
    shadingModel : lit,
    blending : opaque,
    culling : back
}

fragment {
    // UDIM tile lookup: uv0 spans 0..10 over a 10x10 tile grid. Empty tiles
    // never became array layers, so each group carries its own tile->layer
    // table (-1 = absent, weights treated as zero).

    void accumulate(vec4 weights, int group, vec2 suv,
            inout float wsum, inout vec3 albedo, inout float rough,
            inout float ao, inout vec2 nAcc) {
        for (int c = 0; c < 4; c++) {
            float w = weights[c];
            if (w <= 0.002) {
                continue;
            }
            int style = materialParams.styleRemap[group * 4 + c];
            if (style < 0) {
                continue;
            }
            vec3 uv = vec3(suv, float(style));
            vec4 a = texture(materialParams_styleAlbedo, uv);
            vec4 n = texture(materialParams_styleNormal, uv);
            albedo += w * a.rgb;
            rough  += w * a.a;
            ao     += w * n.z;
            nAcc   += w * (n.xy * 2.0 - 1.0);
            wsum   += w;
        }
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // Blender's glTF exporter writes V = 1 - V_blender globally. With UDIM
        // UVs spanning [0,10], exported V runs [-9,1]: floor(v) = -tileRow and
        // the in-tile V is already GPU (top-row-first) correct.
        // (scripts/build-terrain.py probes this and refuses other modes.)
        vec2 uv10 = clamp(getUV0(), vec2(0.0, -9.0), vec2(9.999999, 0.999999));
        vec2 tileCoord = floor(uv10);
        vec2 tileUV = uv10 - tileCoord;
        int tile = int(tileCoord.x) + 10 * int(-tileCoord.y);

        vec4 w0 = vec4(0.0);
        vec4 w1 = vec4(0.0);
        vec4 w2 = vec4(0.0);

        int layer0 = materialParams.tileLayer0[tile];
        if (layer0 >= 0) {
            w0 = texture(materialParams_splatTiles, vec3(tileUV, float(layer0)));
        }
        int layer1 = materialParams.tileLayer1[tile];
        if (layer1 >= 0) {
            w1 = texture(materialParams_splatTiles, vec3(tileUV, float(layer1)));
        }
        int layer2 = materialParams.tileLayer2[tile];
        if (layer2 >= 0) {
            w2 = texture(materialParams_splatTiles, vec3(tileUV, float(layer2)));
        }

        vec2 suv = getWorldPosition().xz * materialParams.styleTiling;

        float wsum = 0.0;
        vec3 albedo = vec3(0.0);
        float rough = 0.0;
        float ao = 0.0;
        vec2 nAcc = vec2(0.0);

        accumulate(w0, 0, suv, wsum, albedo, rough, ao, nAcc);
        accumulate(w1, 1, suv, wsum, albedo, rough, ao, nAcc);
        accumulate(w2, 2, suv, wsum, albedo, rough, ao, nAcc);

        if (wsum < 0.004) {
            // unpainted area: fall back to the default style at full weight
            vec4 a = texture(materialParams_styleAlbedo, vec3(suv, float(materialParams.defaultStyle)));
            vec4 n = texture(materialParams_styleNormal, vec3(suv, float(materialParams.defaultStyle)));
            albedo = a.rgb;
            rough = a.a;
            ao = n.z;
            nAcc = n.xy * 2.0 - 1.0;
            wsum = 1.0;
        }

        float inv = 1.0 / max(wsum, 1e-4);
        material.baseColor = vec4(albedo * inv, 1.0);
        material.roughness = clamp(rough * inv, 0.05, 1.0);
        material.ambientOcclusion = clamp(ao * inv, 0.0, 1.0);

        // whiteout-style normal reconstruction from the blended tangent xy
        vec2 n2 = nAcc * inv;
        float r2 = clamp(dot(n2, n2), 0.0, 0.98);
        material.normal = normalize(vec3(n2, sqrt(1.0 - r2)));
    }
}
