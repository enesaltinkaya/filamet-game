material {
    name : "TerrainSplat",
    parameters : [
        {
            type : sampler2dArray,
            name : splatTiles
        },
        {
            type : sampler2dArray,
            name : styleAlbedo
        },
        {
            type : sampler2dArray,
            name : styleNormal
        },
        {
            type : sampler2dArray,
            name : defaultAlbedo
        },
        {
            type : sampler2dArray,
            name : defaultNormal
        },
        {
            type : int[100],
            name : tileLayer0
        },
        {
            type : int[100],
            name : tileLayer1
        },
        {
            type : int[100],
            name : tileLayer2
        },
        {
            type : int[12],
            name : styleRemap
        },
        {
            type : float,
            name : sandHeight
        },
        {
            type : float,
            name : sandFade
        },
        {
            type : float,
            name : snowHeight
        },
        {
            type : float,
            name : snowFade
        },
        {
            type : float,
            name : cliffSlope
        },
        {
            type : float,
            name : cliffFade
        },
        {
            type : float,
            name : styleTiling
        }
    ],
    requires : [
        uv0,
        tangents
    ],
    shadingModel : lit,
    blending : opaque,
    culling : back
}

fragment {
    // UDIM tile lookup: uv0 spans 0..10 over a 10x10 tile grid. Empty tiles
    // never became array layers, so each group carries its own tile->layer
    // table (-1 = absent, weights treated as zero).
    // Splat images are painted in Blender, which initializes them opaque
    // black (0,0,0,255): the alpha style is painted by ERASING alpha, so the
    // alpha weight is 1.0 - a (r/g/b are direct weights).

    void accumulate(vec4 weights, int group, vec2 suv,
            inout float wsum, inout vec3 albedo, inout float rough,
            inout float ao, inout vec2 nAcc) {
        for (int c = 0; c < 4; c++) {
            float w = weights[c];
            if (w <= 0.002) {
                continue;
            }
            int style = materialParams.styleRemap[group * 4 + c];
            if (style < 0) {
                continue;
            }
            vec3 uv = vec3(suv, float(style));
            vec4 a = texture(materialParams_styleAlbedo, uv);
            vec4 n = texture(materialParams_styleNormal, uv);
            albedo += w * a.rgb;
            rough  += w * a.a;
            ao     += w * n.z;
            nAcc   += w * (n.xy * 2.0 - 1.0);
            wsum   += w;
        }
    }

    // engine default fallback styles (pak_0_engine, layer order fixed by
    // Terrain.cpp): sand 0, grass 1, snow 2, cliff 3
    void accumulateDefault(float w, float layer, vec2 suv,
            inout float wsum, inout vec3 albedo, inout float rough,
            inout float ao, inout vec2 nAcc) {
        if (w <= 0.002) {
            return;
        }
        vec3 uv = vec3(suv, layer);
        vec4 a = texture(materialParams_defaultAlbedo, uv);
        vec4 n = texture(materialParams_defaultNormal, uv);
        albedo += w * a.rgb;
        rough  += w * a.a;
        ao     += w * n.z;
        nAcc   += w * (n.xy * 2.0 - 1.0);
        wsum   += w;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // Blender's glTF exporter writes V = 1 - V_blender (probed by
        // scripts/build-terrain.py), so the file's V runs [-9,1] — but
        // filament's vertex stage flips V again for the glTF convention
        // (uv0_frag = vec2(u, 1 - v)), handing the fragment shader Blender's
        // original orientation: U,V ∈ [0,10).
        vec2 uv10 = clamp(getUV0(), vec2(0.0), vec2(9.999999));
        vec2 tileCoord = floor(uv10);
        vec2 tileUV = uv10 - tileCoord;
        // tileUV.y is Blender-oriented (0 = tile bottom, from the double V
        // flip above), while the KTX2 tile's V=0 is the image's top row —
        // flip to sample tiles right side up
        tileUV.y = 1.0 - tileUV.y;
        int tile = int(tileCoord.x) + 10 * int(tileCoord.y);

        vec4 w0 = vec4(0.0);
        vec4 w1 = vec4(0.0);
        vec4 w2 = vec4(0.0);

        int layer0 = materialParams.tileLayer0[tile];
        if (layer0 >= 0) {
            w0 = texture(materialParams_splatTiles, vec3(tileUV, float(layer0)));
            w0.a = 1.0 - w0.a;
        }
        int layer1 = materialParams.tileLayer1[tile];
        if (layer1 >= 0) {
            w1 = texture(materialParams_splatTiles, vec3(tileUV, float(layer1)));
            w1.a = 1.0 - w1.a;
        }
        int layer2 = materialParams.tileLayer2[tile];
        if (layer2 >= 0) {
            w2 = texture(materialParams_splatTiles, vec3(tileUV, float(layer2)));
            w2.a = 1.0 - w2.a;
        }

        // filament renders camera-relative (getWorldPosition() = world -
        // camera), so detail tiling and the height-based default blend must
        // use the absolute user world position
        vec3 worldPos = getUserWorldPosition();
        vec2 suv = worldPos.xz * materialParams.styleTiling;

        float wsum = 0.0;
        vec3 albedo = vec3(0.0);
        float rough = 0.0;
        float ao = 0.0;
        vec2 nAcc = vec2(0.0);

        accumulate(w0, 0, suv, wsum, albedo, rough, ao, nAcc);
        accumulate(w1, 1, suv, wsum, albedo, rough, ao, nAcc);
        accumulate(w2, 2, suv, wsum, albedo, rough, ao, nAcc);

        if (wsum < 0.004) {
            // unpainted area: procedural defaults from the engine pak — sand
            // near sea level, snow high up, cliff on steep slopes, grass
            // everywhere else (cliff overrides the others)
            float slope = 1.0 - normalize(getWorldGeometricNormalVector()).y;
            float y = worldPos.y;

            float snowW  = smoothstep(materialParams.snowHeight - materialParams.snowFade,
                    materialParams.snowHeight, y);
            float sandW  = 1.0 - smoothstep(materialParams.sandHeight,
                    materialParams.sandHeight + materialParams.sandFade, y);
            float grassW = (1.0 - snowW) * (1.0 - sandW);
            float cliffW = smoothstep(materialParams.cliffSlope,
                    materialParams.cliffSlope + materialParams.cliffFade, slope);

            float open = 1.0 - cliffW;
            accumulateDefault(sandW * open, 0.0, suv, wsum, albedo, rough, ao, nAcc);
            accumulateDefault(grassW * open, 1.0, suv, wsum, albedo, rough, ao, nAcc);
            accumulateDefault(snowW * open, 2.0, suv, wsum, albedo, rough, ao, nAcc);
            accumulateDefault(cliffW, 3.0, suv, wsum, albedo, rough, ao, nAcc);
        }

        float inv = 1.0 / max(wsum, 1e-4);
        material.baseColor = vec4(albedo * inv, 1.0);
        material.roughness = clamp(rough * inv, 0.05, 1.0);
        material.ambientOcclusion = clamp(ao * inv, 0.0, 1.0);

        // whiteout-style normal reconstruction from the blended tangent xy
        vec2 n2 = nAcc * inv;
        float r2 = clamp(dot(n2, n2), 0.0, 0.98);
        material.normal = normalize(vec3(n2, sqrt(1.0 - r2)));
    }
}
